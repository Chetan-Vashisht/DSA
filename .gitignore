# .gitignore - ignore common build artifacts and editor metadata

# Compiled object files and outputs
*.o
*.obj
*.out
*.exe
a.out

# C++/Java bytecode
*.class

# Shared libraries
*.so
*.dylib
*.dll

# Build directories
/bin/
/build/

# macOS
# Note: `.DS_Store` entries removed — user requested these files to be tracked

# VS Code
.vscode/

# Ignore typical executable files created during local builds
# (some projects produce executables with no extension)
/*
# If a specific executable stays tracked, untrack it then commit. See README for details.
# Compiled outputs anywhere in the repo tree.
**/*.o
**/*.obj
**/*.exe
**/*.out
**/*.a
**/*.so
**/*.dll
**/*.dylib
**/*.class
**/a.out
## Allow tracking two-digit-prefixed folders (e.g., 03_Recursion).
## The broad ignore was causing new numbered folders to be hidden from git.
## If you need to ignore specific folders, add explicit patterns instead.
!00_DSA_Repo/
!00_DSA_Repo/**
!01_Time_Complexity/
!01_Time_Complexity/**
!02_STL/
!02_STL/**
!03_Recursion/
03_Recursion/**
!03_Recursion/*.cpp
!03_Recursion/**/*.cpp
!Practice.cpp
!**/*.cpp


# VS Code / local environment files.
.env
.env.*
.vscode/

# Common build directories in any subfolder.
**/build/
**/cmake-build-*/
**/bin/
**/dist/

# Temporary files created by Code Runner anywhere in the tree.
**/tempCodeRunnerFile.cpp
Practice
# Local-only files
Practice.cpp
