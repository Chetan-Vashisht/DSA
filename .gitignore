# Compiled outputs anywhere in the repo tree.
**/*.o
**/*.obj
**/*.exe
**/*.out
**/*.a
**/*.so
**/*.dll
**/*.dylib
**/*.class
**/a.out
## Allow tracking two-digit-prefixed folders (e.g., 03_Recursion).
## The broad ignore was causing new numbered folders to be hidden from git.
## If you need to ignore specific folders, add explicit patterns instead.
!00_DSA_Repo/
!00_DSA_Repo/**
!01_Time_Complexity/
!01_Time_Complexity/**
!02_STL/
!02_STL/**
!Practice.cpp
!**/*.cpp


# VS Code / local environment files.
.env
.env.*
.DS_Store
.vscode/

# Common build directories in any subfolder.
**/build/
**/cmake-build-*/
**/bin/
**/dist/

# Temporary files created by Code Runner anywhere in the tree.
**/tempCodeRunnerFile.cpp
Practice
# Local-only files
Practice.cpp
