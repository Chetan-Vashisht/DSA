# .gitignore - ignore common build artifacts and editor metadata

# Compiled object files and outputs
*.o
*.obj
*.out
*.exe
a.out

# C++/Java bytecode
*.class

# Shared libraries
*.so
*.dylib
*.dll

# Build directories
/bin/
/build/

# macOS
# Note: `.DS_Store` entries removed — user requested these files to be tracked

# VS Code
.vscode/

# Ignore typical executable files created during local builds
# (some projects produce executables with no extension)
# Do not ignore the entire repo root. Keep source folders tracked.
# Compiled outputs anywhere in the repo tree.
**/*.o
**/*.obj
**/*.exe
**/*.out
**/*.a
**/*.so
**/*.dll
**/*.dylib
**/*.class
**/a.out
## Keep project folders and source files visible to Git.
!00_DSA_Repo/
!00_DSA_Repo/**
!01_Time_Complexity/
!01_Time_Complexity/**
!02_STL/
!02_STL/**
!03_Recursion/
!03_Recursion/**
!03_Recursion/*.cpp
!03_Recursion/**/*.cpp
!04_Arrays/
04_Arrays/*
!04_Arrays/**/*.cpp
!100_RoadmapAndMaterial/
!100_RoadmapAndMaterial/**
!practice/
!practice/**
!Practice.cpp
!**/*.cpp


# VS Code / local environment files.
.env
.env.*
.vscode/

# Common build directories in any subfolder.
**/build/
**/cmake-build-*/
**/bin/
**/dist/

# Temporary files created by Code Runner anywhere in the tree.
**/tempCodeRunnerFile.cpp
Practice
# Local-only files
Practice.cpp

# .gitignore additions

# Ignore local build artifacts and macOS metadata
.DS_Store
**/.DS_Store
**/findLargestElimentInArray
